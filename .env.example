# Application
APP_NAME=SHMS-Backend
APP_ENV=development
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shms_db
DB_USER=postgres
DB_PASSWORD=your_password
# DB_SSLMODE=require   # set for Neon/cloud Postgres; leave commented for local

# Face Recognition Thresholds
FACE_MATCH_THRESHOLD=0.40
FACE_DUPLICATE_THRESHOLD=0.30

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

# SMS (forgot password OTP). Provider: mock | twilio | msg91 | fast2sms
SMS_PROVIDER=mock
SMS_OTP_EXPIRE_MINUTES=2

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE=+1234567890

# MSG91 (if SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=SHMS_OTP

# Fast2SMS (if SMS_PROVIDER=fast2sms)
# FAST2SMS_API_KEY=your_api_key
